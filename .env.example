# Salin file ini ke .env.local untuk dev. Jangan commit nilai asli.
# Di Vercel set Environment Variables dengan nama yang sama.

# Koneksi MongoDB (mis. MongoDB Atlas): user:password dan nama database.
MONGODB_URI=
MONGODB_DB=

# JSON service account Firebase admin — SATU nilai utuh (bukan baris per baris).
FIREBASE_SERVICE_ACCOUNT=

# Daftar email (dipisah koma) berlevel akses; dipakai server sebagai sumber kebenaran.
# Pemilik (azwarptk5@gmail.com) selalu admin dan tidak bisa diturunkan.
TRUSTED_EMAILS=
ADMIN_EMAILS=